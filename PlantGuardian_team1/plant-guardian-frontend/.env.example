# Copy this file to .env and point it at your backend.
# Local backend (uvicorn main:app --reload, default port 8000):
REACT_APP_API_URL=http://127.0.0.1:8000

# Deployed backend (Cloud Run / ngrok) - swap in your real URL before "npm run build":
# REACT_APP_API_URL=https://plant-guardian-backend-xxxxx.a.run.app
